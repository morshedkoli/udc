{
  "name": "service-logger-dashboard",
  "version": "1.0.0",
  "description": "কালিকচ্ছ ইউনিয়ন ডিজিটাল সেন্টার — সেবা লগার ডেস্কটপ অ্যাপ",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^4.5.14",
    "dotenv": "^17.2.3",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "next": "^16.0.10",
    "node-fetch": "^3.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^8.2.2",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "electron-updater": "^6.7.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kalikachudc.servicelogger",
    "productName": "Kalikachh UDC Service Logger",
    "copyright": "Copyright © 2024 কালিকচ্ছ ইউনিয়ন ডিজিটাল সেন্টার",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.ts",
      ".env.local"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UDC Service Logger",
      "include": "build/installer.nsh"
    }
  }
}